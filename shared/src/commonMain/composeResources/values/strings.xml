    <!-- The line on each page's card on Home and About -->
    <string name="page_card_detail">Browse the card in the Knob over its Wi-Fi: download, upload, make folders and delete.</string>
    <string name="page_status_detail">See over Bluetooth the Knob's firmware, card, how long it has run and how many Wi-Fi networks it sees.</string>
    <string name="page_knob_settings_detail">Change the Knob's theme, brightness, clicks and orientation over Bluetooth.</string>
    <string name="page_firmware_detail">Update the Knob's firmware over Bluetooth from a signed file.</string>
    <string name="page_plugins_detail">Send plugins to the Knob over Bluetooth, from the catalogue or your own.</string>
    <string name="page_help_detail">How to use the app, page by page.</string>
